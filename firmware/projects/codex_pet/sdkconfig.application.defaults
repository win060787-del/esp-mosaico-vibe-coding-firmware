# Keep the OTA writer only in the retained factory Recovery image. The normal
# application exposes the enter-Recovery RPC through iris_ota_support_start().
# CONFIG_ESP_IRIS_OTA is not set
CONFIG_ESP_IRIS_USB_PRODUCT="ESP-Iris Mosaico codex_pet"
CONFIG_ESP_IRIS_HEALTH_TIMEOUT_MS=45000

# Three retained-Recovery handlers plus eight application handlers.
CONFIG_ESP_IRIS_MAX_RPC_HANDLERS=20

# Keep scarce DMA-capable internal RAM available to the display and audio.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
